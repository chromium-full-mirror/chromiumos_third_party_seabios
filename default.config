#
# SeaBIOS Configuration
# Mon Oct 11 13:11:20 2012
#
# This is a default configuration of upstream SeaBIOS (plus
# our local changes) with the following changes made:
#
# Enabled the following options:
# - CONFIG_COREBOOT
# - CONFIG_BOOTMENU_KEY_ESC
# - CONFIG_NON_DEFAULT_CBFS
# - CONFIG_CBFS_HEADER=0xffdffffc
# - CONFIG_FLASH_FLOPPY
#
# Disabled the following options:
# - CONFIG_THREADS
# - CONFIG_BOOTSPLASH
# - CONFIG_ATA
# - CONFIG_FLOPPY
# - CONFIG_USB_OHCI
# - CONFIG_USB_MOUSE
# - CONFIG_LPT
# - CONFIG_MOUSE
#
# If you make changes to this file, please keep the above header updated.
#
#

#
# General Features
#
CONFIG_COREBOOT=y
# CONFIG_THREADS is not set
CONFIG_RELOCATE_INIT=y
CONFIG_BOOTMENU=y
# CONFIG_BOOTMENU_KEY_F2 is not set
CONFIG_BOOTMENU_KEY_ESC=y
# CONFIG_BOOTSPLASH is not set
CONFIG_BOOTORDER=y
CONFIG_COREBOOT_FLASH=y
CONFIG_LZMA=y
CONFIG_NON_DEFAULT_CBFS=y
CONFIG_CBFS_HEADER=0xffdffffc
CONFIG_FLASH_FLOPPY=y

#
# Hardware support
#
# CONFIG_ATA is not set
CONFIG_AHCI=y
# CONFIG_FLOPPY is not set
CONFIG_PS2PORT=y
CONFIG_USB=y
CONFIG_USB_UHCI=y
# CONFIG_USB_OHCI is not set
CONFIG_USB_EHCI=y
CONFIG_USB_MSC=y
CONFIG_USB_HUB=y
CONFIG_USB_KEYBOARD=y
CONFIG_SERIAL=y
# CONFIG_LPT is not set

#
# BIOS interfaces
#
CONFIG_DRIVES=y
CONFIG_CDROM_BOOT=y
CONFIG_CDROM_EMU=y
CONFIG_PCIBIOS=y
CONFIG_APMBIOS=y
CONFIG_PNPBIOS=y
CONFIG_OPTIONROMS=y
# CONFIG_OPTIONROMS_DEPLOYED is not set
CONFIG_PMM=y
CONFIG_BOOT=y
CONFIG_KEYBOARD=y
CONFIG_KBD_CALL_INT15_4F=y
# CONFIG_MOUSE is not set
CONFIG_S3_RESUME=y
CONFIG_VGAHOOKS=y
# CONFIG_DISABLE_A20 is not set

#
# BIOS Tables
#
CONFIG_SMBIOS=y

#
# VGA ROM
#
CONFIG_NO_VGABIOS=y
# CONFIG_VGA_GEODEGX2 is not set
# CONFIG_VGA_GEODELX is not set
# CONFIG_BUILD_VGABIOS is not set

#
# Debugging
#
CONFIG_DEBUG_LEVEL=8
# CONFIG_DEBUG_SERIAL is not set
# CONFIG_DEBUG_SERIAL_OXFORD is not set
