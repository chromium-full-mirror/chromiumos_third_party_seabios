#
# This is a default configuration of upstream SeaBIOS with the
# following changes made:
#
# Enabled the following options:
# - CONFIG_COREBOOT
# - CONFIG_THREAD_OPTIONROMS
# - CONFIG_DEBUG_SERIAL_OXFORD
#
# Disabled the following options:
# - CONFIG_FLOPPY
# - CONFIG_LPT
# - CONFIG_BOOTSPLASH
#
# If you make changes to this file, please keep the above header updated.
#
# SeaBIOS Configuration
#

#
# General Features
#
CONFIG_COREBOOT=y
CONFIG_THREADS=y
CONFIG_THREAD_OPTIONROMS=y
CONFIG_RELOCATE_INIT=y
CONFIG_BOOTMENU=y
CONFIG_BOOTMENU_WAIT=2500
# CONFIG_BOOTSPLASH is not set
CONFIG_BOOTORDER=y
CONFIG_COREBOOT_FLASH=y
CONFIG_LZMA=y
CONFIG_FLASH_FLOPPY=y

#
# Hardware support
#
CONFIG_ATA=y
# CONFIG_ATA_DMA is not set
# CONFIG_ATA_PIO32 is not set
CONFIG_AHCI=y
# CONFIG_FLOPPY is not set
CONFIG_PS2PORT=y
CONFIG_USB=y
CONFIG_USB_UHCI=y
CONFIG_USB_OHCI=y
CONFIG_USB_EHCI=y
CONFIG_USB_MSC=y
CONFIG_USB_HUB=y
CONFIG_USB_KEYBOARD=y
CONFIG_USB_MOUSE=y
CONFIG_SERIAL=y
# CONFIG_LPT is not set
# CONFIG_EXTRA_PCI_ROOTS is not set

#
# BIOS interfaces
#
CONFIG_DRIVES=y
CONFIG_CDROM_BOOT=y
CONFIG_CDROM_EMU=y
CONFIG_PCIBIOS=y
CONFIG_APMBIOS=y
CONFIG_PNPBIOS=y
CONFIG_OPTIONROMS=y
# CONFIG_OPTIONROMS_DEPLOYED is not set
CONFIG_OPTIONROMS_CHECKSUM=y
CONFIG_PMM=y
CONFIG_BOOT=y
CONFIG_KEYBOARD=y
CONFIG_KBD_CALL_INT15_4F=y
CONFIG_MOUSE=y
CONFIG_S3_RESUME=y
# CONFIG_S3_RESUME_VGA_INIT is not set
CONFIG_VGAHOOKS=y
# CONFIG_DISABLE_A20 is not set

#
# BIOS Tables
#
CONFIG_SMBIOS=y

#
# Debugging
#
CONFIG_DEBUG_LEVEL=1
# CONFIG_DEBUG_SERIAL is not set
CONFIG_DEBUG_SERIAL_OXFORD=y
CONFIG_SCREEN_AND_DEBUG=y
